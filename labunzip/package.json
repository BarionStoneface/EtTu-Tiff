{
  "name": "labunzip",
  "version": "1.0.0",
  "private": true,
  "description": "Unpacks film lab zips, including nested zips, with a review step for folder names, filename patterns, metadata and dates.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "register": "node scripts/register-context-menu.js",
    "unregister": "node scripts/unregister-context-menu.js",
    "dist": "electron-builder --win",
    "shortcut": "node scripts/create-shortcut.js",
    "fix-dates": "node scripts/fix-dates.js"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "exiftool-vendored": "28.3.1",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.oneplusonecreatives.labunzip",
    "productName": "LabUnzip",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "scripts/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
